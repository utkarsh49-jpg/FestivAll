# ==============================================================================
# FestivAll – Campus Event & Auditorium Booking System
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# 1. Copy this file to `backend/.env` for backend server execution.
# 2. Replace all placeholder values (<PLACEHOLDER>) with your actual configuration.
# 3. NEVER commit your actual `.env` file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=<YOUR_POSTGRESQL_PASSWORD>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_event_booking

# ------------------------------------------------------------------------------
# Application Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Provide a strong, cryptographically secure 256-bit secret for signing JWT tokens
JWT_SECRET=<YOUR_LONG_RANDOM_JWT_SECRET_KEY>

# Token Expiration (e.g., 2h, 24h, 7d)
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# Frontend Application (Client Configuration)
# ------------------------------------------------------------------------------
# Base API URL used by the frontend development server / test runners
VITE_API_URL=http://localhost:5000
