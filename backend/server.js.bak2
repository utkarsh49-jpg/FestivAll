// Get all venues (Public)
app.get("/api/venues", async (req, res) => {
    try {
        const result = await pool.query(
            "SELECT * FROM venues ORDER BY id"
        );

        res.json(result.rows);
    } catch (error) {
        console.error(error);
        res.status(500).json({
            error: "Failed to fetch venues"
        });
    }
});

// Get all events (Public)
app.get("/api/events", async (req, res) => {
    try {
        const result = await pool.query(`
            SELECT
                e.id,
                e.title,
                e.description,
                e.event_date,
                e.start_time,
                e.end_time,
                e.venue_id,
                v.name AS venue_name,
                v.location AS venue_location,
                e.organizer_id,
                e.status,
                e.created_at
            FROM events e
            JOIN venues v ON e.venue_id = v.id
            ORDER BY e.event_date, e.start_time
        `);

        res.json(result.rows);
    } catch (error) {
        console.error(error);
        res.status(500).json({
            error: "Failed to fetch events"
        });
    }
});

// Get seats for a specific event (Public)
app.get("/api/events/:eventId/seats", async (req, res) => {
    try {
        const { eventId } = req.params;

        const result = await pool.query(
            `
            SELECT
                id,
                event_id,
                seat_number,
                status
            FROM event_seats
            WHERE event_id = $1
            ORDER BY id
            `,
            [eventId]
        );

        res.json(result.rows);
    } catch (error) {
        console.error(error);

        res.status(500).json({
            error: "Failed to fetch seats"
        });
    }
});

// =========================================================
// RESERVATION ENDPOINTS (AUTHENTICATED & AUTHORIZED)
// =========================================================

// Book a seat (Authenticated: user_id derived from verified JWT)
app.post("/api/reservations", authenticateToken, async (req, res) => {
    const client = await pool.connect();

    try {
        const { event_id, seat_id } = req.body;
        // Safeguard 7: user_id derived from authenticated token, not request body
        const user_id = req.user.id;

        if (!event_id || !seat_id) {
            return res.status(400).json({
                error: "event_id and seat_id are required"
            });
        }

        await client.query("BEGIN");

        // Lock the selected seat
        const seatResult = await client.query(
            `
            SELECT id, event_id, seat_number, status
            FROM event_seats
            WHERE id = $1 AND event_id = $2
            FOR UPDATE
            `,
            [seat_id, event_id]
        );

        if (seatResult.rows.length === 0) {
            await client.query("ROLLBACK");
            return res.status(404).json({
                error: "Seat not found for this event"
            });
        }

        const seat = seatResult.rows[0];

        // Check whether the seat is already booked
        if (seat.status === "BOOKED") {
            await client.query("ROLLBACK");

            return res.status(409).json({
                error: "Seat is already booked"
            });
        }

        // Create reservation
        const reservationResult = await client.query(
            `
            INSERT INTO reservations
                (event_id, seat_id, user_id, status)
            VALUES
                ($1, $2, $3, 'ACTIVE')
            RETURNING *
            `,
            [event_id, seat_id, user_id]
        );

        const reservation = reservationResult.rows[0];

        // Mark seat as booked
        await client.query(
            `
            UPDATE event_seats
            SET status = 'BOOKED'
            WHERE id = $1
            `,
            [seat_id]
        );

        // Add booking history
        await client.query(
            `
            INSERT INTO booking_history
                (reservation_id, action, performed_by)
            VALUES
                ($1, 'BOOKED', $2)
            `,
            [reservation.id, user_id]
        );

        await client.query("COMMIT");

        res.status(201).json({
            message: "Seat booked successfully",
            reservation: reservation
        });

    } catch (error) {
        await client.query("ROLLBACK");

        console.error(error);

        res.status(500).json({
            error: "Failed to book seat"
        });
    } finally {
        client.release();
    }
});

// Get a single reservation by ID
app.get("/api/reservations/:id", async (req, res) => {
    try {
        const reservationId = req.params.id;

        const result = await pool.query(
            "SELECT * FROM reservations WHERE id = $1",
            [reservationId]
        );

        if (result.rows.length === 0) {
            return res.status(404).json({
                error: "Reservation not found"
            });
        }

        res.status(200).json(result.rows[0]);

    } catch (error) {
        console.error(error);

        res.status(500).json({
            error: "Failed to fetch reservation"
        });
    }
});

// Get all reservations
app.get("/api/reservations", async (req, res) => {
    try {
        const result = await pool.query(`
            SELECT
                r.id,
                r.event_id,
                r.seat_id,
                r.user_id,
                r.status,
                r.booked_at,
                r.cancelled_at
            FROM reservations r
            ORDER BY r.id;
        `);

        res.status(200).json(result.rows);
    } catch (error) {
        console.error(error);

        res.status(500).json({
            error: "Failed to fetch reservations"
        });
    }
});

// Cancel a reservation (Authenticated: only owner or ADMIN can cancel)
app.delete("/api/reservations/:id", authenticateToken, async (req, res) => {
    const client = await pool.connect();  
    const reservationId = req.params.id;

    try {
        await client.query("BEGIN");

        // Get the reservation with row lock
        const result = await client.query(
            `SELECT event_id, seat_id, user_id, status
             FROM reservations
             WHERE id = $1
             FOR UPDATE`,
            [reservationId]
        );

        if (result.rows.length === 0) {
            await client.query("ROLLBACK");
            return res.status(404).json({
                error: "Reservation not found"
            });
        }

        const reservation = result.rows[0];

        // Safeguard 8: Ensure authorization checks occur before modifying any records
        const isOwner = String(reservation.user_id) === String(req.user.id);
        const isAdmin = req.user.role === "ADMIN";

        if (!isOwner && !isAdmin) {
            await client.query("ROLLBACK");
            return res.status(403).json({
                error: "Access denied: you can only cancel your own reservations"
            });
        }

        if (reservation.status === "CANCELLED") {
            await client.query("ROLLBACK");
            return res.status(400).json({
                error: "Reservation is already cancelled"
            });
        }

        // Cancel reservation
        await client.query(
            `UPDATE reservations
             SET status = 'CANCELLED',
                 cancelled_at = CURRENT_TIMESTAMP
             WHERE id = $1`,
            [reservationId]
        );

        // Make seat available again
        await client.query(
            `UPDATE event_seats
             SET status = 'AVAILABLE'
             WHERE id = $1`,
            [reservation.seat_id]
        );

        // Add booking history
        await client.query(
            `INSERT INTO booking_history
             (reservation_id, action, performed_by)
             VALUES ($1, 'CANCELLED', $2)`,
            [reservationId, req.user.id]
        );

        await client.query("COMMIT");

        res.json({
            message: "Reservation cancelled successfully",
            reservation_id: Number(reservationId)
        });

    } catch (error) {
        try {
            await client.query("ROLLBACK");
        } catch (rollbackError) {
            console.error("Rollback failed:", rollbackError.message);
        }

        console.error(error);

        res.status(500).json({
            error: "Failed to cancel reservation"
        });
    } finally {
        client.release();
    }
});

const PORT = 5000;

app.listen(PORT, () => {
    console.log(`🚀 Server running on http://localhost:${PORT}`);
});