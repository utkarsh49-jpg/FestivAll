      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register New Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Returns JWT token and user profile', function () {",
                  "    pm.expect(res).to.have.property('token');",
                  "    pm.expect(res.user).to.have.property('id');",
                  "    pm.expect(res.user.role).to.eql('STUDENT');",
                  "    pm.expect(res.user).to.not.have.property('password_hash');",
                  "});",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('studentToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Postman Test Student\",\n    \"email\": \"postman_student_{{$timestamp}}@campus.edu\",\n    \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
